# Règles de mise en forme communes à tous les éditeurs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne forcent un retour à la ligne en Markdown.
trim_trailing_whitespace = false

[*.sql]
indent_size = 4
