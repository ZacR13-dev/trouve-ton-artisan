# =====================================================================
# Modèle de configuration de l'API
# ---------------------------------------------------------------------
# Copiez ce fichier vers « .env » puis renseignez vos propres valeurs.
# Le fichier .env n'est jamais versionné : il contient des secrets.
# =====================================================================

# --- Application ---------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Base de données -----------------------------------------------
# Utilisez le compte applicatif créé par 01-create-database.sql,
# jamais le compte root.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=tta_app
DB_PASSWORD=

# --- Sécurité ------------------------------------------------------
# Clé partagée avec le front, exigée dans l'en-tête x-api-key.
# Générez-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Origines autorisées à appeler l'API depuis un navigateur.
# Plusieurs valeurs possibles, séparées par des virgules.
CORS_ORIGIN=http://localhost:5173

# --- Envoi d'e-mail (formulaire de contact) ------------------------
# Relais SMTP authentifié. Laisser vide en développement : les messages
# sont alors affichés dans la console au lieu d'être envoyés.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Trouve ton artisan <no-reply@trouve-ton-artisan.fr>

# Les adresses des artisans du jeu d'essai sont fictives. Renseignez
# votre propre adresse ici : tous les messages y seront redirigés au
# lieu de partir vers ces adresses.
MAIL_REDIRECT_TO=

# --- Limitation de débit -------------------------------------------
# Fenêtre en millisecondes et nombre maximal de requêtes par IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Limite spécifique au formulaire de contact, par heure.
RATE_LIMIT_CONTACT_MAX=5
