# =====================================================================
# Modèle de configuration du front
# ---------------------------------------------------------------------
# Copiez ce fichier vers « .env » puis renseignez vos propres valeurs.
#
# Attention : dans une application front, toute variable VITE_* est
# intégrée au code envoyé au navigateur et reste donc lisible par le
# visiteur. Aucun secret réel ne doit être placé ici. La clé ci-dessous
# sert à restreindre l'usage de l'API, pas à protéger des données
# confidentielles (voir docs/veille-securite.md, section 5).
# =====================================================================

# Adresse de l'API, sans barre oblique finale.
VITE_API_URL=http://localhost:3001/api

# Doit correspondre exactement à la variable API_KEY du fichier api/.env.
VITE_API_KEY=
